# 飞书企业自建应用凭证（开放平台 → 凭证与基础信息）
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me

# 回答用哪个 AI：codex（本机 Codex CLI，无需 Key，较慢）或 deepseek（下面的接口，需要 Key，较快）
AI_PROVIDER=codex

# Codex CLI（AI_PROVIDER=codex 时使用；需先在本机登录过 codex）
# 留空则自动用 %LOCALAPPDATA%\OpenAI\Codex\bin 下最新的 codex.exe（Codex 更新后目录名会变）；填的路径失效时也会自动回退
CODEX_PATH=
# 可选：模型、推理强度（low 更快，medium/high 更准）、同时运行的 Codex 进程数
# CODEX_MODEL=
CODEX_REASONING_EFFORT=low
CODEX_CONCURRENCY=2

# DeepSeek（AI_PROVIDER=deepseek 时使用；任意兼容 OpenAI Chat Completions 的服务都可以）
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=replace_me
# deepseek-chat 速度快；deepseek-reasoner 推理更强但更慢
AI_MODEL=deepseek-chat
# 单次 AI 请求超时（秒）；不填时 codex 默认 300，deepseek 默认 120
# AI_TIMEOUT_SECONDS=
AI_TEMPERATURE=0.3

# CICD 打包报错分析接口（打包失败后打包机 POST 日志过来，机器人返回分析）
CICD_ANALYZE_ENABLED=true
CICD_ANALYZE_HOST=10.234.30.88
CICD_ANALYZE_PORT=3210
# 与打包机环境变量 CICD_AI_TOKEN 保持一致；留空则局域网内谁都能调用
CICD_ANALYZE_TOKEN=
# 打包分析用的 AI，不填则跟随 AI_PROVIDER；打包机最多等 120 秒，嫌慢可单独设为 deepseek
# CICD_AI_PROVIDER=deepseek
# CICD_AI_TIMEOUT_SECONDS=110
# 打包失败时除了触发人，额外 @ 的人（飞书姓名，多个用逗号隔开）
CICD_FAILURE_ALSO_AT=

# 群聊中 @机器人 时带上的最近群消息条数（1-50）
FEISHU_HISTORY_LIMIT=20
# 知识库自动增量同步间隔（分钟，0 = 只在启动和 /sync 时同步）
WIKI_SYNC_MINUTES=60
WIKI_MAX_DOCS=3000
# 收到消息时打的表情回复，留空则不打
ACK_EMOJI=OnIt
# 可选：配置文件和本地数据目录
# BOT_CONFIG=bot.config.json
# DATA_DIR=data
